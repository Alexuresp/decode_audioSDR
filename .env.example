# Groq API Key (get one for free at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Default translation target language (e.g., Ukrainian, English, Spanish)
DEFAULT_TARGET_LANGUAGE=Ukrainian

# Default Whisper transcription language (optional, e.g., 'en', 'uk', 'ru', or leave empty for auto-detect)
# Specifying a language can improve transcription quality
WHISPER_LANGUAGE=
